#!name=CN Direct + Apple Split + Global Proxy
#!desc=Mainland China domains and IPs plus private LAN go DIRECT; Apple China domains direct; Apple services outside China proxy; all remaining traffic PROXY.
#!author=ChatGPT
#!homepage=https://github.com/yuppieq/open

[Rule]
# ===== Local LAN / NAS / home router: DIRECT =====
DOMAIN,localhost,DIRECT
DOMAIN-SUFFIX,local,DIRECT
DOMAIN-SUFFIX,home.arpa,DIRECT
IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
IP-CIDR6,::1/128,DIRECT,no-resolve
IP-CIDR6,fc00::/7,DIRECT,no-resolve
IP-CIDR6,fe80::/10,DIRECT,no-resolve

# ===== Apple services explicitly hosted on China domains: DIRECT =====
DOMAIN-SUFFIX,apple.com.cn,DIRECT
DOMAIN-SUFFIX,icloud.com.cn,DIRECT
DOMAIN-SUFFIX,apple.cn,DIRECT
DOMAIN-SUFFIX,icloud.cn,DIRECT

# ===== Mainland China domains and IPs: DIRECT (upstream lists update daily) =====
DOMAIN-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/China/China_Domain.list,DIRECT
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/China/China.list,DIRECT
GEOIP,CN,DIRECT

# ===== Apple global services outside China: PROXY =====
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/Apple/Apple.list,PROXY

# ===== All other unmatched overseas traffic: PROXY =====
FINAL,PROXY
